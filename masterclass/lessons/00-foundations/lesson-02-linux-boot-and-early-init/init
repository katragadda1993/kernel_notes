#!/bin/sh
# This script becomes PID 1 inside the teaching initramfs.
PATH=/bin:/sbin
export PATH

# This argument is only for the host-side chroot validation. A real boot
# enters the shell below; PID 1 must not simply exit.
if [ "$#" -gt 0 ] && [ "$1" = "--self-test" ]; then
    echo '[initramfs] self-test OK'
    exit 0
fi

mount -t proc proc /proc 2>/dev/null || :
mount -t sysfs sysfs /sys 2>/dev/null || :
mount -t devtmpfs devtmpfs /dev 2>/dev/null || :

echo '[initramfs] PID 1 started'
echo '[initramfs] early userspace is alive'
exec /bin/sh
